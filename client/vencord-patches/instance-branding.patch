diff --git a/src/utils/types.ts b/src/utils/types.ts
index 5d25b17..b40f27c 100644
--- a/src/utils/types.ts
+++ b/src/utils/types.ts
@@ -28,8 +28,19 @@ import { Command, FluxEvents } from "@vencord/discord-types";
 import { ReactNode } from "react";
 import { LiteralUnion } from "type-fest";
 
+export const instanceName = () => (globalThis as any).GLOBAL_ENV?.INSTANCE_NAME || "Fosscord";
+
+export const hiddenPlugins = new Set(["FakeNitro"]);
+
+export const brand = <T,>(text: T): T =>
+    typeof text === "string"
+        ? text.replace(/\bDiscord\b/g, instanceName()).replace(/\bDISCORD\b/g, instanceName().toUpperCase()).replace(/\bNitro\b/g, "Premium") as T
+        : text;
+
 // exists to export default definePlugin({...})
 export default function definePlugin<P extends PluginDef>(p: P & Record<PropertyKey, any>) {
+    p.description = brand(p.description);
+    if (hiddenPlugins.has(p.name)) p.hidden = true;
     return p as typeof p & Plugin;
 }
 
